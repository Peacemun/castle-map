{
  "name": "castle-map",
  "version": "1.0.0",
  "description": "Castle Map — 1,000 years of warfare, castles and changing borders in Britain (AD 1000–2000)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "data:fetch": "tsx scripts/import/fetch-sources.ts",
    "data:build": "tsx scripts/build-data/build.ts",
    "data:validate": "tsx scripts/validate/validate.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run data:validate"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "maplibre-gl": "^6.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.3",
    "@turf/turf": "^7.4.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
