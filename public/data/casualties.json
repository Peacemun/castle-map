[{"id":"cas-harrying-north-1069","eventId":"evt-harrying-north-1069","scope":"aggregate","preferred":true,"category":"civilian","method":"contemporary-claim","sources":[{"sourceId":"src-orderic"},{"sourceId":"src-kapelle"}],"confidence":"very-low","notes":"Orderic Vitalis states that more than 100,000 people died of famine. The figure is rhetorical and unverifiable, so no quantity is used. Deaths are recorded as unknown."},{"id":"cas-berwick-1296","eventId":"evt-berwick-1296","scope":"event","preferred":true,"category":"mixed","method":"contemporary-claim","sources":[{"sourceId":"src-prestwich-edward"},{"sourceId":"src-barrow-bruce"}],"confidence":"very-low","notes":"Chronicle figures range from several thousand to tens of thousands and contradict one another. Recorded as unknown."},{"id":"cas-york-1190","eventId":"evt-york-massacre-1190","scope":"event","preferred":true,"killedCentral":150,"category":"civilian","method":"modern-estimate","sources":[{"sourceId":"src-dobson-york-1190"}],"confidence":"medium","notes":"Usually given as about 150 members of the Jewish community."},{"id":"cas-bedford-1224","eventId":"evt-bedford-1224","scope":"event","preferred":true,"killedMin":80,"category":"military","side":"Garrison of Falkes de Bréauté","method":"contemporary-claim","sources":[{"sourceId":"src-carpenter-minority"}],"confidence":"medium","notes":"More than eighty of the garrison were hanged after the surrender. Deaths during the siege itself are not known."},{"id":"cas-towton-1461","eventId":"evt-towton-1461","scope":"event","preferred":true,"killedMax":28000,"category":"military","method":"contemporary-claim","sources":[{"sourceId":"src-boardman-towton"},{"sourceId":"src-goodman-wor"}],"confidence":"low","notes":"28,000 is the contemporary heralds' count reported in letters after the battle. Many historians consider it inflated; no agreed lower figure exists, so it is stored as an upper bound only."},{"id":"cas-bosworth-1485-richard","eventId":"evt-bosworth-1485","scope":"event","preferred":true,"killedCentral":1000,"category":"military","side":"Army of Richard III","method":"contemporary-claim","sources":[{"sourceId":"src-foard-curry-bosworth"}],"confidence":"low","notes":"Polydore Vergil's figure of about 1,000 dead on Richard's side."},{"id":"cas-bosworth-1485-henry","eventId":"evt-bosworth-1485","scope":"event","preferred":true,"killedCentral":100,"category":"military","side":"Army of Henry Tudor","method":"contemporary-claim","sources":[{"sourceId":"src-foard-curry-bosworth"}],"confidence":"low","notes":"Polydore Vergil's figure of about 100 dead on Henry's side."},{"id":"cas-flodden-1513-scots","eventId":"evt-flodden-1513","scope":"event","preferred":true,"killedCentral":10000,"category":"military","side":"Scottish army","method":"modern-estimate","sources":[{"sourceId":"src-barr-flodden"}],"confidence":"low","notes":"About 10,000 is the most commonly cited figure; contemporary and modern estimates vary widely."},{"id":"cas-flodden-1513-english","eventId":"evt-flodden-1513","scope":"event","preferred":true,"killedCentral":1500,"category":"military","side":"English army","method":"modern-estimate","sources":[{"sourceId":"src-barr-flodden"}],"confidence":"low","notes":"About 1,500 is commonly cited."},{"id":"cas-dussindale-1549","eventId":"evt-dussindale-1549","scope":"event","preferred":true,"killedCentral":3000,"category":"military","side":"Kett's rebels","method":"contemporary-claim","sources":[{"sourceId":"src-goodall"}],"confidence":"low","notes":"Accounts commonly give about 3,000 rebels killed; the basis of the figure is uncertain."},{"id":"cas-marston-moor-1644","eventId":"evt-marston-moor-1644","scope":"event","preferred":true,"killedCentral":4150,"category":"military","side":"Both armies (mostly royalist)","method":"burial-record","sources":[{"sourceId":"src-newman-marston"},{"sourceId":"src-carlton"}],"confidence":"medium","notes":"Contemporary report that local people buried 4,150 bodies; most were royalists."},{"id":"cas-naseby-1645-royalist","eventId":"evt-naseby-1645","scope":"event","preferred":true,"killedCentral":1000,"category":"military","side":"Royalist army","captured":{"min":4500,"max":4500},"method":"modern-estimate","sources":[{"sourceId":"src-foard-naseby"},{"sourceId":"src-carlton"}],"confidence":"low","notes":"About 1,000 royalists killed and about 4,500 captured are commonly given. Women of the royalist baggage train were also killed in the pursuit (number uncertain)."},{"id":"cas-bolton-1644","eventId":"evt-bolton-1644","scope":"event","preferred":true,"killedMax":1600,"category":"mixed","method":"contemporary-claim","sources":[{"sourceId":"src-carlton"}],"confidence":"very-low","notes":"Partisan contemporary reports give figures up to about 1,600 soldiers and townspeople; stored as an upper bound only."},{"id":"cas-dunbar-1650-scots","eventId":"evt-dunbar-1650","scope":"event","preferred":true,"killedCentral":3000,"category":"military","side":"Scottish army","captured":{"min":10000,"max":10000},"method":"contemporary-claim","sources":[{"sourceId":"src-cromwell-letters"},{"sourceId":"src-woolrych"}],"confidence":"low","notes":"Cromwell reported about 3,000 Scots slain and 10,000 prisoners. Deaths among prisoners on the march south and at Durham are NOT included."},{"id":"cas-dunbar-1650-english","eventId":"evt-dunbar-1650","scope":"event","preferred":true,"killedCentral":20,"category":"military","side":"English army","method":"contemporary-claim","sources":[{"sourceId":"src-cromwell-letters"}],"confidence":"very-low","notes":"Cromwell claimed English losses of about twenty men; probably an understatement."},{"id":"cas-worcester-1651","eventId":"evt-worcester-1651","scope":"event","preferred":true,"killedCentral":3000,"category":"military","side":"Scottish-royalist army","method":"modern-estimate","sources":[{"sourceId":"src-woolrych"}],"confidence":"low","notes":"About 3,000 is commonly given for royalist dead; many more were captured."},{"id":"cas-sedgemoor-1685","eventId":"evt-sedgemoor-1685","scope":"event","preferred":true,"killedCentral":1000,"category":"military","side":"Monmouth's rebels","method":"modern-estimate","sources":[{"sourceId":"src-he-battlefields"}],"confidence":"low","notes":"About 1,000 rebels killed in the battle and pursuit; later executions are not included."},{"id":"cas-glencoe-1692","eventId":"evt-glencoe-1692","scope":"event","preferred":true,"killedCentral":38,"category":"civilian","method":"modern-estimate","sources":[{"sourceId":"src-hopkins-glencoe"}],"confidence":"high","notes":"Thirty-eight killed. Further deaths from exposure after the burning of homes (often put at about forty) are not included."},{"id":"cas-prestonpans-1745-gov","eventId":"evt-prestonpans-1745","scope":"event","preferred":true,"killedCentral":300,"category":"military","side":"Government army","captured":{"min":1500,"max":1500},"method":"modern-estimate","sources":[{"sourceId":"src-duffy-45"}],"confidence":"low","notes":"About 300 killed and about 1,500 captured are commonly given."},{"id":"cas-culloden-1746-jacobite","eventId":"evt-culloden-1746","scope":"event","preferred":true,"killedMin":1500,"killedMax":2000,"category":"military","side":"Jacobite army","method":"modern-estimate","sources":[{"sourceId":"src-duffy-45"}],"confidence":"medium","notes":"Estimates of 1,500–2,000 often combine killed and wounded; many wounded were killed after the battle."},{"id":"cas-culloden-1746-gov","eventId":"evt-culloden-1746","scope":"event","preferred":true,"killedCentral":50,"category":"military","side":"Government army","method":"official-record","sources":[{"sourceId":"src-duffy-45"}],"confidence":"medium","notes":"About 50 killed; about 250 wounded."},{"id":"cas-peterloo-1819","eventId":"evt-peterloo-1819","scope":"event","preferred":true,"killedMin":15,"killedMax":18,"category":"civilian","wounded":{"min":400,"max":700},"method":"modern-estimate","sources":[{"sourceId":"src-poole-peterloo"}],"confidence":"high","notes":"Between 15 and 18 deaths; several hundred injured."},{"id":"cas-merthyr-1831","eventId":"evt-merthyr-1831","scope":"event","preferred":true,"killedMin":16,"category":"civilian","method":"contemporary-claim","sources":[{"sourceId":"src-cadw"}],"confidence":"low","notes":"At least sixteen killed; the true number is unknown."},{"id":"cas-newport-1839","eventId":"evt-newport-1839","scope":"event","preferred":true,"killedCentral":22,"category":"civilian","side":"Chartists","method":"modern-estimate","sources":[{"sourceId":"src-jones-newport"}],"confidence":"medium","notes":"Commonly given as about 22."},{"id":"cas-coast-raid-1914","eventId":"evt-coast-raid-1914","scope":"aggregate","includesAccountIds":["cas-hartlepool-1914","cas-scarborough-1914","cas-whitby-1914"],"preferred":true,"killedCentral":137,"category":"mixed","wounded":{"min":592,"max":592},"method":"official-record","sources":[{"sourceId":"src-corbett-naval-ops"}],"confidence":"high","notes":"Total for the raid. Town-level accounts are mapped individually; only the unallocated remainder (if any) belongs to this record."},{"id":"cas-hartlepool-1914","eventId":"evt-hartlepool-1914","scope":"event","preferred":true,"killedMin":86,"killedMax":116,"category":"mixed","method":"mixed","sources":[{"sourceId":"src-corbett-naval-ops"}],"confidence":"low","notes":"Sources differ on how Hartlepool's dead are counted (civilians, soldiers, later deaths). The lower bound is the commonly quoted count; the upper bound is the raid total (137) minus the upper figures for Scarborough and Whitby, so the town accounts can never exceed the documented total."},{"id":"cas-scarborough-1914","eventId":"evt-scarborough-1914","scope":"event","preferred":true,"killedMin":17,"killedMax":18,"category":"civilian","method":"official-record","sources":[{"sourceId":"src-corbett-naval-ops"}],"confidence":"medium"},{"id":"cas-whitby-1914","eventId":"evt-whitby-1914","scope":"event","preferred":true,"killedMin":2,"killedMax":3,"category":"civilian","method":"official-record","sources":[{"sourceId":"src-corbett-naval-ops"}],"confidence":"medium"},{"id":"cas-zeppelin-london-1915","eventId":"evt-zeppelin-london-1915","scope":"event","preferred":true,"killedCentral":7,"category":"civilian","method":"official-record","sources":[{"sourceId":"src-jones-war-in-air"}],"confidence":"medium"},{"id":"cas-gotha-london-1917","eventId":"evt-gotha-london-1917","scope":"event","preferred":true,"killedCentral":162,"category":"civilian","wounded":{"min":432,"max":432},"method":"official-record","sources":[{"sourceId":"src-jones-war-in-air"}],"confidence":"high"},{"id":"cas-blitz-london-1940","eventId":"evt-blitz-london-1940","scope":"aggregate","includesAccountIds":["cas-london-10-may-1941"],"preferred":true,"killedMin":18000,"killedMax":21500,"category":"civilian","method":"modern-estimate","sources":[{"sourceId":"src-obrien-civil-defence"},{"sourceId":"src-gardiner-blitz"}],"confidence":"very-low","notes":"DERIVED RANGE — requires verification. Secondary summaries commonly state that roughly 40,000–43,000 civilians died in the Blitz (Sept 1940 – May 1941), almost half of them in London. This range is derived from that statement, not taken from an official London tally. The 10–11 May 1941 raid is a separate child account and is not counted twice."},{"id":"cas-london-10-may-1941","eventId":"evt-london-10-may-1941","scope":"event","preferred":true,"killedCentral":1436,"category":"civilian","method":"official-record","sources":[{"sourceId":"src-obrien-civil-defence"},{"sourceId":"src-gardiner-blitz"}],"confidence":"high"},{"id":"cas-coventry-1940","eventId":"evt-coventry-1940","scope":"event","preferred":true,"killedCentral":568,"category":"civilian","method":"official-record","sources":[{"sourceId":"src-obrien-civil-defence"},{"sourceId":"src-gardiner-blitz"}],"confidence":"high","notes":"Official figure; some later estimates are higher."},{"id":"cas-birmingham-1940","eventId":"evt-birmingham-1940","scope":"event","preferred":true,"killedCentral":2241,"category":"civilian","method":"official-record","sources":[{"sourceId":"src-gardiner-blitz"}],"confidence":"medium","notes":"Total for all raids on Birmingham, 1940–43."},{"id":"cas-sheffield-1940","eventId":"evt-sheffield-1940","scope":"event","preferred":true,"killedCentral":660,"category":"civilian","method":"modern-estimate","sources":[{"sourceId":"src-gardiner-blitz"}],"confidence":"low","notes":"About 660 is commonly given; requires verification."},{"id":"cas-cardiff-1941","eventId":"evt-cardiff-1941","scope":"event","preferred":true,"killedCentral":165,"category":"civilian","method":"official-record","sources":[{"sourceId":"src-gardiner-blitz"}],"confidence":"medium"},{"id":"cas-swansea-1941","eventId":"evt-swansea-1941","scope":"event","preferred":true,"killedCentral":230,"category":"civilian","method":"official-record","sources":[{"sourceId":"src-gardiner-blitz"}],"confidence":"high"},{"id":"cas-clydebank-1941","eventId":"evt-clydebank-1941","scope":"event","preferred":true,"killedCentral":528,"category":"civilian","method":"official-record","sources":[{"sourceId":"src-gardiner-blitz"}],"confidence":"high"},{"id":"cas-plymouth-1941","eventId":"evt-plymouth-1941","scope":"event","preferred":true,"killedCentral":1172,"category":"civilian","method":"official-record","sources":[{"sourceId":"src-gardiner-blitz"}],"confidence":"medium","notes":"Civilian deaths in Plymouth across all raids, 1940–44."},{"id":"cas-liverpool-1941","eventId":"evt-liverpool-1941","scope":"event","preferred":true,"killedCentral":1741,"category":"civilian","method":"official-record","sources":[{"sourceId":"src-gardiner-blitz"}],"confidence":"low","notes":"Figure commonly given for Liverpool in the May Blitz; requires verification (Merseyside-wide totals are higher)."},{"id":"cas-bath-1942","eventId":"evt-bath-1942","scope":"event","preferred":true,"killedCentral":417,"category":"civilian","method":"official-record","sources":[{"sourceId":"src-gardiner-blitz"}],"confidence":"high"},{"id":"cas-v-weapons-1944","eventId":"evt-v-weapons-1944","scope":"aggregate","includesAccountIds":["cas-guards-chapel-1944","cas-new-cross-1944"],"preferred":true,"killedCentral":8938,"category":"civilian","method":"official-record","sources":[{"sourceId":"src-obrien-civil-defence"}],"confidence":"medium","notes":"Sum of the commonly cited official totals: about 6,184 killed by V-1s (all of Britain) and about 2,754 by V-2s in London. The two named incidents are child accounts."},{"id":"cas-guards-chapel-1944","eventId":"evt-guards-chapel-1944","scope":"event","preferred":true,"killedCentral":121,"category":"mixed","method":"official-record","sources":[{"sourceId":"src-obrien-civil-defence"}],"confidence":"high"},{"id":"cas-new-cross-1944","eventId":"evt-new-cross-1944","scope":"event","preferred":true,"killedCentral":168,"category":"civilian","method":"official-record","sources":[{"sourceId":"src-obrien-civil-defence"}],"confidence":"high"}]